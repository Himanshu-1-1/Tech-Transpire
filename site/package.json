{
  "name": "techtranspire-website",
  "private": true,
  "type": "module",
  "description": "www.techtranspire.com, rebuilt on Astro. Content comes from docs/website-architecture/data.",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:public": "cross-env SITE_MODE=public astro build",
    "preview": "astro preview",
    "check:content": "node --experimental-strip-types --no-warnings scripts/check-content.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "puppeteer-core": "^24.43.1"
  }
}
