{
  "name": "techtranspire-website",
  "private": true,
  "type": "module",
  "description": "www.techtranspire.com, rebuilt on Astro. Content comes from docs/website-architecture/data.",
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:markers": "cross-env REVIEW_MARKERS=1 astro dev",
    "build": "astro build",
    "build:public": "cross-env SITE_MODE=public astro build",
    "build:pages": "cross-env PAGES=1 astro build && node scripts/pages-base.mjs dist-pages",
    "deploy:pages": "npm run build:pages && node scripts/deploy-pages.mjs",
    "preview": "astro preview",
    "preview:public": "node dist-public/server/entry.mjs",
    "test": "node --experimental-strip-types --no-warnings --test tests/inquiry.test.ts",
    "check:content": "node --experimental-strip-types --no-warnings scripts/check-content.mjs",
    "check:links": "node scripts/check-links.mjs dist/client && node scripts/check-links.mjs dist-public/client",
    "validate": "npm run build && npm run build:public && npm test && npm run check:content && npm run check:links",
    "qa": "node scripts/qa-interactions.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^5.18.2",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "cross-env": "^10.1.0",
    "puppeteer-core": "^24.43.1"
  }
}
