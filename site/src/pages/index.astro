---
// Home. Narrative: understand the challenge → establish credibility → explain the approach
// → demonstrate outcomes → start a conversation. First fold follows the approved reference.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Flag from '../components/Flag.astro';
import Blueprint from '../components/Blueprint.astro';
import InsightCard from '../components/InsightCard.astro';
import CtaBand from '../components/CtaBand.astro';
import MethodPath from '../components/MethodPath.astro';
import NodeGrid from '../components/NodeGrid.astro';
import FaultLines from '../components/FaultLines.astro';
import FitList from '../components/FitList.astro';
import FlipStatement from '../components/FlipStatement.astro';
import { block, lines, cards, steps, callout, fitlist, carouselPairs, ctas, team } from '../lib/content';
import { insightById, insightHref, visibleInsights, visibleById } from '../lib/insights';
import { isVisibleInsight, CASE_STUDIES } from '../lib/routes';
import { visibleResults } from '../lib/results';
import ResultViz from '../components/ResultViz.astro';
import { isVerified, claims } from '../lib/claims';
import { photo, asset } from '../lib/images';
import { approvals, isReview, showMarkers, contact } from '../lib/site';

const [, heroLead, heroSub] = lines(block('TT-PG-001-B02'));
// Hero lead on two lines, breaking after "execution," (company request 2026-10-30). Words unchanged.
const heroLeadLines = heroLead.split(/(?<=,) (?=so )/);
const [opening, seeWhatBreaks, ...statements] = carouselPairs(block('TT-PG-001-B01'));
const problems = cards(block('TT-PG-001-B03'));
const [methodTitle, methodLead, methodSub] = lines(block('TT-PG-001-B04'));
const method = steps(block('TT-PG-001-B05'));
const outcome = callout(block('TT-PG-001-B06'));
const fit = fitlist(block('TT-PG-001-B07'));
const [startConversation, seeOurWork] = ctas(block('TT-PG-001-B09'));
const [aboutEyebrow, aboutTitle, aboutSub] = lines(block('TT-PG-004-B01'));
const mack = team(block('TT-PG-004-B04'))[0];
const founderIntro = mack.bio[0].split('. ')[0] + '.';
const showFounder = isReview || isVerified('C-10');
const showTimeframe = isReview || isVerified('C-15');
// Leadership photography: only the labelled original (not the AI-generated archive image).
const mackPhoto = photo('mack akhani');

// Approved outcome themes (2026-10-29). Supporting lines are N-02 drafts, review build only.
const themes = [
  { title: 'Better Decisions', icon: 'bars', line: 'Decisions on systems, vendors and process design made on a validated problem definition, not under pressure.', insight: 'TT-INS-006' },
  { title: 'Improved Performance', icon: 'people', line: 'Time, effort and quality measured before and after, so improvement is visible rather than assumed.', insight: 'TT-INS-005' },
  { title: 'Efficient Operations', icon: 'settings', line: 'Processes, handoffs and ownership that work end to end, not just step by step.', insight: 'TT-INS-008' },
  { title: 'Sustainable Transformation', icon: 'leaf', line: 'Results your own team can keep improving.', insight: 'TT-INS-010' },
].map((t) => ({ ...t, article: insightById(t.insight), linked: isVisibleInsight(t.insight) }));
const showThemeLines = isReview || approvals.outcomeThemeCopy;

const featured = [...visibleById(['TT-INS-003', 'TT-INS-006', 'TT-INS-008']), ...visibleInsights].filter((v, i, a) => a.indexOf(v) === i).slice(0, 3);
// Hero: the executive lounge photo when present (company request 2026-10-30), else the glass
// office skyline. The closing band keeps its brand-blue gradient.
const lounge = photo('hero section') ?? photo('lounge');
const heroPhoto = lounge ?? photo('skyline');
const heroAlt = lounge ? 'Executives in conversation in a lounge overlooking a city skyline at dusk' : 'Glass-walled office overlooking a city skyline at sunrise';
const ctaPhoto = undefined;
const [first, second] = ['Clarity Before Change.', 'Confidence Through Execution.'];
---
<Base
  title="Tech Transpire — Clarity Before Change. Confidence Through Execution."
  description="We bring clarity to complex systems before execution, so mid-sized organizations at high-stakes transformation points move forward with confidence."
  heroHeader
>
  <Fragment slot="head">{heroPhoto && <link rel="preload" as="image" href={heroPhoto.src} fetchpriority="high" />}</Fragment>

  <!-- 1 · Brand statement -->
  <section class="hero" aria-labelledby="hero-h" data-parallax>
    <div class="hero-media" style={lounge ? '--hero-pos: 100% 50%' : undefined}>
      {heroPhoto
        ? <Image src={heroPhoto} alt={heroAlt} widths={[900, 1400, 2000]} sizes="(max-width: 899px) 100vw, 60vw" loading="eager" fetchpriority="high" />
        : <div class="media-fallback"><Blueprint idSuffix="hero" /></div>}
      {/* Liquid glass (desktop): redraws the photo with the floating chips as refracting glass
          (interactions.ts heroGlass). Hidden until it has the photo; without WebGL2 the chips keep
          their frosted CSS look. */}
      {heroPhoto && <canvas class="hero-glass" aria-hidden="true"></canvas>}
    </div>
    <div class="hero-light" aria-hidden="true"></div>
    {/* Floating method chips: three of the five step titles [E], at different parallax depths.
        On load the method plays once and rests: 01 switches on, its trace draws to 04, 04 switches
        on, the trace draws to 05, 05 completes with a check (interactions.ts heroFlow). Traces are
        drawn from the chips' measured positions every frame, so they stay attached as they float.
        Decorative duplicates of the Method section. */}
    <div class="hero-chips" aria-hidden="true" data-step="0">
      <svg class="hero-flow" focusable="false">
        <path class="flow-base" data-leg="0" pathLength="1" />
        <path class="flow-base" data-leg="1" pathLength="1" />
        <path class="flow-pulse" data-leg="0" pathLength="1" />
        <path class="flow-pulse" data-leg="1" pathLength="1" />
        <circle class="flow-dot" data-leg="0" r="3.5" />
        <circle class="flow-dot" data-leg="1" r="3.5" />
        <path class="flow-arrow" data-leg="0" />
        <path class="flow-arrow" data-leg="1" />
      </svg>
      {/* With the lounge photo the chips sit in the sky, clear of the people (lower right). */}
      <div class="chip-float" style={`--depth:22;--top:${lounge ? '10%' : '18%'};--left:${lounge ? '6%' : '12%'};--d:9`}><span class="chip-node"></span><span class="chip-n">01</span><span class="chip-t">{method[0].title}</span></div>
      <div class="chip-float" style={`--depth:36;--top:${lounge ? '21%' : '42%'};--left:${lounge ? '58%' : '62%'};--d:10`}><span class="chip-node"></span><span class="chip-n">04</span><span class="chip-t">{method[3].title}</span></div>
      <div class="chip-float" style={`--depth:28;--top:${lounge ? '38%' : '72%'};--left:${lounge ? '30%' : '30%'};--d:11`}><span class="chip-node chip-node--end"><svg class="chip-check" viewBox="0 0 12 12" focusable="false"><path d="M2.6 6.3 L5 8.6 L9.4 3.6" pathLength="1" /></svg></span><span class="chip-n">05</span><span class="chip-t">{method[4].title}</span></div>
    </div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1 id="hero-h">
          <span class="line"><span style="--d:0">{first}</span></span>{' '}
          {/* Two lines of equal width (company request 2026-10-30): line 2 is sized down in CSS. */}
          <span class="line line--2 accent"><span style="--d:1">{second.split(' ')[0]}{' '}<span class="ul">{second.split(' ').slice(1).join(' ')}<svg class="underline" viewBox="0 0 300 14" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M2 9 C 70 3, 150 3, 298 7" pathLength="1" /></svg></span></span></span>
        </h1>
        <p class="lead enter" style="--d:4">{heroLeadLines.map((l, i) => <>{i > 0 && <>{' '}<br class="lead-br" /></>}{l}</>)}</p>
        <div class="ctas enter" style="--d:5">
          <a class="btn btn-primary" href={startConversation.href} data-magnetic><span class="btn-label">{startConversation.label}</span> <span class="arr" aria-hidden="true">→</span></a>
          <a class="link-arrow" href="/services">Explore Our Expertise <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </div>
      {!heroPhoto && <p class="hero-caption"><Flag label="Photograph pending: “Executive Meeting Above the Skyline”" /></p>}
    </div>
  </section>

  {/* Outcome dock: glass bar of the four approved outcome themes. Desktop: a gradient highlight
      glides to the hovered outcome (and sweeps across once after the hero), icon orbs draw a ring
      and play a small motion of their own. Phones: the same items, static. */}
  <nav class="container outcome-bar enter" style="--d:6" aria-label="What we help you achieve" data-dock>
    <ul>
      {themes.map((t) => (
        <li class="ob-item" data-k={t.icon}><a href="#outcomes"><span class="ob-orb"><Icon name={t.icon} /></span><span class="ob-text">{t.title.split(' ')[0]}<small>{t.title.split(' ').slice(1).join(' ')}</small></span><span class="ob-arrow" aria-hidden="true">→</span></a></li>
      ))}
      <li class="ob-glider" aria-hidden="true"></li>
    </ul>
  </nav>

  <!-- Section rail (desktop): where you are on the page -->
  <nav class="rail" aria-label="Sections on this page">
    <a href="#challenge"><span>Challenge</span></a>
    <a href="#experience"><span>Experience</span></a>
    <a href="#method"><span>Method</span></a>
    <a href="#outcomes"><span>Outcomes</span></a>
    <a href="#insights"><span>Insights</span></a>
    <a href="#conversation"><span>Conversation</span></a>
  </nav>

  <!-- 2 · Understand the challenge -->
  <section class="section challenge" id="challenge" aria-labelledby="familiar-h" data-ambient>
    <div class="container">
      <div class="ch-head">
        <div class="section-head">
          <h2 id="familiar-h" data-split>{opening.prompt}</h2>
          <p class="lead">{seeWhatBreaks.statement}</p>
        </div>
        {/* "Want to learn more?" sits under the graphic (company mark-up, 2026-10-30). */}
        <div class="ch-art">
          <FaultLines />
          <a class="link-arrow" href="#method">{seeWhatBreaks.prompt} <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="statements">
        {statements.map((s, i) => <FlipStatement n={i} statement={s.statement} prompt={s.prompt} link={{ label: seeWhatBreaks.prompt, href: '#method' }} />)}
      </div>
      {/* Intro to the problem cards. Copy supplied by the company in its mockup (2026-10-30, D-37). */}
      <div class="ch-intro reveal">
        <p class="ch-rule"><span>Things we look for</span></p>
        <h3 class="ch-title" data-split>Complexity Isn't the Problem. Lack of Clarity Is.</h3>
        <p class="ch-sub">The patterns below are often the first signs that a transformation is heading off course.</p>
      </div>
      <ul class="grid grid-3 ch-cards">
        {problems.map((p, i) => (
          <li class="card reveal" data-tilt>
            <span class="ch-glow" aria-hidden="true"></span><span class="ch-bar" aria-hidden="true"></span>
            <span class="icon-tile"><Icon name={p.icon} /></span><h3>{p.title}</h3><p>{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3 · Establish credibility -->
  <section class="section section--mist" id="experience" aria-labelledby="built-h">
    <div class:list={['container', 'founder', { 'founder--solo': !showFounder }]}>
      {showFounder && (
        <figure class="founder-photo reveal" style="--fp: 50% 16%">
          {mackPhoto
            ? <Image src={mackPhoto} alt={`${mack.name}, ${mack.role}`} widths={[440, 760]} sizes="(max-width: 819px) 360px, 440px" />
            : <div class="monogram" aria-hidden="true">MA</div>}
          <figcaption><strong>{mack.name}</strong><span>{mack.role}</span>{!mackPhoto && <Flag label="Photo pending: “Mack Akhani.png”" />}</figcaption>
        </figure>
      )}
      <div class="founder-copy reveal">
        <p class="eyebrow">{aboutEyebrow}</p>
        <h2 id="built-h" data-split>{aboutTitle}</h2>
        <p class="lead">{aboutSub}</p>
        {showFounder && <p>{founderIntro}<Flag label="C-10 · confirm “over two decades”" /></p>}
        {showFounder && isVerified('C-11') && <ul class="credentials"><li><Icon name="award" />Lean Six Sigma Black Belt<Flag label="C-11 ✓ · wording to approve" ok /></li></ul>}
        <a class="link-arrow" href="/about-us">About Tech Transpire <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 4 · Explain the approach: signature method graphic -->
  <section class="section section--sky" id="method" aria-labelledby="method-h" data-glow>
    <div class="sky-aura" aria-hidden="true"></div>
    <NodeGrid tone="light" />
    <div class="container">
      <div class="two-col" style="margin-bottom: clamp(48px, 5vw, 72px)">
        <div class="section-head" style="margin:0">
          <p class="eyebrow">Clarity before Execution.</p>
          <h2 id="method-h" data-split>{methodTitle}</h2>
        </div>
        <div style="display:grid;gap:14px">
          <p class="lead">{methodLead}</p>
          <p class="muted">{methodSub}</p>
        </div>
      </div>
      <MethodPath steps={method} id="method-steps" />
      <aside class="panel reveal" style="margin-top: clamp(56px, 6vw, 88px)" aria-labelledby="outcome-h">
        <div>
          <p class="eyebrow" id="outcome-h">{outcome.title}</p>
          <p class="panel-title">{outcome.lead}</p>
        </div>
        <div class="panel-body">
          {outcome.body.map((p) => <p>{p}</p>)}
          {outcome.tag && showTimeframe && <p class="tag"><svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><polygon points="4,4 13,4 20,12 13,20 4,20 11,12" fill="#3E9FDE" /></svg>{outcome.tag}</p>}
          <a class="link-arrow" href="/services">Implementation Clarity &amp; Execution Blueprint <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </aside>
    </div>
  </section>

  <!-- 5 · Demonstrate outcomes -->
  <section class="section" id="outcomes" aria-labelledby="themes-h">
    <div class="container">
      <div class="section-head">
        <h2 id="themes-h" data-split>What we help you achieve<Flag label="Heading: approve (themes approved)" /></h2>
      </div>
      <ul class="grid grid-4">
        {themes.map((t) => (
          <li class="photo-card reveal" data-tilt>
            <div class="ph"><Image src={asset(t.article.cover)} alt="" widths={[400, 700]} sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 300px" /></div>
            <div class="body">
              <span class="icon-tile"><Icon name={t.icon} /></span>
              <h3>{t.linked ? <a href={insightHref(t.article)}>{t.title}</a> : t.title}</h3>
              {showThemeLines && <p>{t.line}<Flag label="N-02 draft" /></p>}
              {t.linked && <div class="foot"><span>Read: {t.article.cardTitle}</span><span class="go" aria-hidden="true">→</span></div>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {visibleResults.length > 0 && (
    <section class="section section--navy results-band" aria-labelledby="results-h" data-glow>
      {/* Blueprint grid and light: the experience ledger sits on deep navy (2026-11-01). */}
      <svg class="results-grid" aria-hidden="true" focusable="false"><defs><pattern id="rg-cell" width="48" height="48" patternUnits="userSpaceOnUse"><path d="M48 0H0V48" fill="none" stroke="currentColor" stroke-width="1" /></pattern></defs><rect width="100%" height="100%" fill="url(#rg-cell)" /></svg>
      <div class="container">
        <div class="section-head section-head--split">
          <div style="display:grid;gap:14px">
            <h2 id="results-h" data-split>Selected Experience</h2>
            <p class="muted" style="max-width:62ch">Engagements led by our team, including before Tech Transpire Brand was created. Each is labelled accordingly.</p>
          </div>
          <a class="link-arrow results-cta" href={CASE_STUDIES}>Read the case studies <span class="arr" aria-hidden="true">→</span></a>
        </div>
        <ul class="results">
          {visibleResults.map((r) => (
            <li class="result reveal" data-spotlight>
              <ResultViz claim={r.claim} />
              <span class="result-value" data-count={r.value}>{r.value}</span>
              <span class="result-label">{r.label}</span>
              {r.attribution && <span class="result-attr"><i aria-hidden="true"></i>{r.attribution}</span>}
              <span><Flag label={`${r.claim} · ${claims[r.claim]?.status === 'verified' ? 'verified' : 'pending verification'}${r.attributionPending ? ' · attribution pending (C-18)' : ''}`} /></span>
              {r.insightSlug && isVisibleInsight(r.insightId!) && <a href={`/insights/${r.insightSlug}`}>Read the engagement <span class="arr" aria-hidden="true">→</span></a>}
            </li>
          ))}
        </ul>
        {showMarkers && <p class="muted" style="margin-top:20px;font-size:14px">Review note: the public build shows only verified results and hides this section until at least two are verified.</p>}
      </div>
    </section>
  )}

  {featured.length > 0 && (
    <section class="section" id="insights" aria-labelledby="insights-h">
      <div class="container">
        <div class="section-head section-head--split">
          <h2 id="insights-h" data-split>Insights</h2>
          <a class="link-arrow" href="/insights">View all insights <span class="arr" aria-hidden="true">→</span></a>
        </div>
        <ul class:list={['grid', featured.length === 3 ? 'grid-3' : 'grid-2']}>{featured.map((i) => <InsightCard insight={i} />)}</ul>
      </div>
    </section>
  )}

  {/* Full fit list, as documented in the Home page Word file (2026-10-30, D-32). */}
  <section class="section section--mist" id="fit" aria-labelledby="fit-h">
    <div class="container">
      <div class="section-head">
        <h2 id="fit-h" data-split>Is this the right fit?</h2>
        <p class="lead">{heroSub}</p>
      </div>
      <div class="reveal"><FitList items={fit} /></div>
    </div>
  </section>

  <!-- 6 · Start a conversation: CTA and CTA2 exactly as in the Home page Word file -->
  <CtaBand
    id="conversation"
    eyebrow="Start the conversation"
    line={opening.statement}
    ctas={[{ label: startConversation.label, href: startConversation.href }, { label: seeOurWork.label, href: seeOurWork.href }, { label: 'Book a 30-minute intro call', href: contact.booking }]}
    photo={ctaPhoto}
  />
</Base>
