---
// About (/about-us, D-23). Profiles publish individually once confirmed (D-07); the Akhani LLC
// paragraph is N-06 Option B, subject to legal wording (D-08).
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import Flag from '../components/Flag.astro';
import CtaBand from '../components/CtaBand.astro';
import PersonCard from '../components/PersonCard.astro';
import { block, lines, cards, team, ctas } from '../lib/content';
import { isVerified } from '../lib/claims';
import type { ImageMetadata } from 'astro';
import { photo } from '../lib/images';
import { isReview, approvals, location } from '../lib/site';
import advisorData from '../data/advisors.json';

const [eyebrow, title, lead] = lines(block('TT-PG-004-B01'));
const story = block('TT-PG-004-B02');
const values = block('TT-PG-004-B03');
const teamBlock = block('TT-PG-004-B04');
const message = block('TT-PG-004-B05');
const [workWithUs, caseStudies] = ctas(block('TT-PG-004-B06'));
const [closingLine, ...statements] = [...lines(message)].reverse();

// Gating per person: the claims each profile depends on (12 §3, D-07).
const gates: Record<string, string[]> = {
  'Mack Akhani': ['C-10', 'C-02', 'C-05', 'C-06', 'C-07'],
  'Hemang Dwivedi': ['C-20'],
  'Kranthi Kumar Goli': ['C-12'],
  'Devjet Bag': ['C-13'],
};
// Portraits: only labelled original photographs. TT-AS-003, 005 and 006 are AI-generated
// images in Drive ("ChatGPT Image…", "Gemini_Generated_Image…") and are not used.
const portraits: Record<string, ImageMetadata | undefined> = {
  'Mack Akhani': photo('mack akhani'),
  'Hemang Dwivedi': photo('hemang dwivedi'), // supplied in chat 2026-11-01 (TT-AS-029); replaces TT-AS-004
  'Kranthi Kumar Goli': photo('kranthi kumar goli'), // supplied in chat 2026-11-01 (TT-AS-027)
  'Devjet Bag': photo('devjet bag'), // supplied in chat 2026-11-01 (TT-AS-028)
};
// Focal point per portrait in the tall card (Mack's, Kranthi's and Devjet's photos are tall three-quarter shots).
const focus: Record<string, string> = {
  'Mack Akhani': '58% 16%',
  'Hemang Dwivedi': '46% 30%',
  'Kranthi Kumar Goli': '62% 18%',
  'Devjet Bag': '50% 24%',
};
// Advisor portraits supplied by the company, matched by name: [name in advisors.json, photo, focal point].
const advisorPhotos = ([['Wally Potts', photo('wally potts'), '52% 30%']] as [string, ImageMetadata | undefined, string][]).filter(([, img]) => img);
const people = team(teamBlock).filter((p) => isReview || isVerified(...gates[p.name]));
---
<Base title="About | Tech Transpire" description="We built the company we always wanted to be part of: one that embraces complexity, challenges assumptions and refuses to execute without clarity.">
  <PageHeader eyebrow={eyebrow} title={title} lead={lead} crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]}>
    <p class="muted">Based in {location.label}.</p>
  </PageHeader>

  <section class="section" id="story" aria-labelledby="story-h">
    <div class="container two-col">
      <div class="section-head" style="margin:0"><h2 id="story-h">{story.heading}</h2></div>
      <div class="prose">{story.text.map((p) => <p>{p}</p>)}</div>
    </div>
  </section>

  <section class="section section--mist" id="values" aria-labelledby="values-h">
    <div class="container">
      <div class="section-head"><h2 id="values-h">{values.heading}</h2></div>
      <ul class="grid grid-3">
        {cards(values).map((v) => <li class="card reveal" data-tilt><span class="icon-tile"><Icon name={v.icon} /></span><h3>{v.title}</h3><p>{v.body}</p></li>)}
      </ul>
    </div>
  </section>

  {people.length > 0 && (
    <section class="section" id="team" aria-labelledby="team-h">
      <div class="container">
        <div class="section-head"><h2 id="team-h">{teamBlock.heading}</h2></div>
        <ul class="people people--team">
          {people.map((p) => (
            <PersonCard name={p.name} role={p.role} bio={p.bio} linkedin={p.linkedin} photo={portraits[p.name]} focus={focus[p.name]}>
              <Flag label={`Publishes when confirmed: ${gates[p.name].join(', ')}${portraits[p.name] ? '' : ' · approved photo needed (AI-generated image not used)'}`} block />
            </PersonCard>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* Advisors (D-38): imported verbatim from trueleansolutions.com/about-us at the company's
      request; initials until the company supplies a photograph (Wally Potts: supplied 2026-11-01, TT-AS-030). Review build only until
      approved: each advisor's agreement and the figures in the bios need confirming (D-38, D-39). */}
  {(isReview || approvals.advisors) && (
    <section class="section" id="advisors" aria-labelledby="advisors-h">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">{advisorData.eyebrow}</p>
          <h2 id="advisors-h" data-split>{advisorData.title}</h2>
          <p class="lead">{advisorData.lead}</p>
        </div>
        <ul class="people people--advisors">
          {advisorData.advisors.map((a) => { const ap = advisorPhotos.find(([k]) => a.name.includes(k)); return <PersonCard name={a.name} role={a.role} bio={a.bio} linkedin={a.linkedin} photo={ap?.[1]} focus={ap?.[2]} />; })}
        </ul>
      </div>
    </section>
  )}

  <section class="section section--mist" id="message" aria-labelledby="message-h">
    <div class="container">
      <div class="section-head"><h2 id="message-h">{message.heading}</h2></div>
      <div class="quote-list" style="max-width:860px">
        {statements.reverse().map((s) => <blockquote class="reveal">{s}</blockquote>)}
      </div>
    </div>
  </section>

  {(isReview || approvals.akhaniParagraph) && (
    <section class="section section--tight" id="relationships" aria-labelledby="rel-h">
      <div class="container narrow">
        <h2 id="rel-h" style="font-size:1.4rem">Our company<Flag label="N-06 Option B · legal wording review" /></h2>
        <p class="muted" style="margin-top:14px">Tech Transpire is a DBA of Akhani LLC. Akhani LLC also operates True Lean Solutions, which focuses on software development, automation, integration and implementation. Tech Transpire leads the advisory work: understanding the problem, aligning stakeholders and designing the plan. Where a client needs hands-on build capacity, we can introduce True Lean Solutions as one option.</p>
      </div>
    </section>
  )}

  <CtaBand line={closingLine} ctas={[workWithUs, caseStudies]} />
</Base>

<script>
  // Profile cards: "See less" closes the bio and brings the card back into view if it scrolled away.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-pc-less]:not([data-wired])').forEach((btn) => {
      btn.dataset.wired = '';
      btn.addEventListener('click', () => {
        const details = btn.closest('details');
        if (!details) return;
        details.open = false;
        const card = details.closest<HTMLElement>('.pcard');
        if (card && card.getBoundingClientRect().top < 80) card.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
        details.querySelector('summary')?.focus({ preventScroll: true });
      });
    });
  });
</script>
