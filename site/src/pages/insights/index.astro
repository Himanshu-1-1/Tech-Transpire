---
// Insights hub. One filter, by content type (D-18: no outcome-theme filter until each theme
// has at least three articles). The case-studies listing is the indexable, no-JS equivalent.
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import InsightCard from '../../components/InsightCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { paragraph } from '../../lib/content';
import { visibleInsights as insights, TYPE_LABEL, type InsightType } from '../../lib/insights';
import { hasCaseStudiesPage } from '../../lib/routes';

const intro = paragraph('TT-PG-003-B02', 'Practical insights');
const plural: Record<InsightType, string> = { 'case-study': 'Case studies', perspective: 'Perspectives', guide: 'Guides' };
const types = (Object.keys(TYPE_LABEL) as InsightType[]).map((t) => ({ t, n: insights.filter((i) => i.type === t).length })).filter((x) => x.n > 0);
---
<Base title="Insights | Tech Transpire" description={intro}>
  <PageHeader title="Insights" lead={intro} crumbs={[{ label: 'Home', href: '/' }, { label: 'Insights' }]} />
  <section class="section" aria-labelledby="list-h">
    <div class="container">
      <h2 id="list-h" class="visually-hidden">All insights</h2>
      <div class="filters" role="group" aria-label="Filter by type">
        <button class="chip" type="button" data-filter="all" aria-pressed="true">All <span class="count">{insights.length}</span></button>
        {types.map(({ t, n }) => <button class="chip" type="button" data-filter={t} aria-pressed="false">{plural[t]} <span class="count">{n}</span></button>)}
        {hasCaseStudiesPage && <a class="chip" href="/insights/case-studies" style="margin-left:auto">Case studies page →</a>}
      </div>
      <p class="visually-hidden" aria-live="polite" id="filter-status"></p>
      <ul class:list={['grid', insights.length < 3 ? 'grid-2' : 'grid-3']} id="insight-list">{insights.map((i) => <InsightCard insight={i} />)}</ul>
    </div>
  </section>
  <CtaBand eyebrow="Start the conversation" line="Most companies don't fail in execution, they fail before it begins." ctas={[{ label: 'Start a Conversation', href: '/contact-us' }]} />
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]:not([data-wired])');
  chips.forEach((c) => (c.dataset.wired = ''));
  const items = document.querySelectorAll<HTMLElement>('#insight-list > li');
  const status = document.getElementById('filter-status');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    const f = chip.dataset.filter;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    let shown = 0;
    items.forEach((li) => { const on = f === 'all' || li.dataset.type === f; li.hidden = !on; if (on) { shown++; li.classList.add('is-in'); } });
    if (status) status.textContent = `${shown} insights shown`;
  }));
  });
</script>
