---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/libre-franklin';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { isReview, SITE_NAME, location } from '../lib/site';
import { logo } from '../lib/images';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  ogImage?: ImageMetadata;
  jsonLd?: object[];
  draft?: string;
  heroHeader?: boolean;
}
const { title, description, ogImage, jsonLd = [], draft, heroHeader = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '') || Astro.site!.href;
const og = await getImage({ src: ogImage ?? logo, width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;
const favicon = await getImage({ src: logo, width: 64, format: 'png' });
const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE_NAME,
  legalName: 'Akhani LLC',
  url: Astro.site!.href,
  email: 'info@techtranspire.com',
  telephone: '+1-979-479-2779',
  address: { '@type': 'PostalAddress', addressLocality: location.locality, addressRegion: location.region, addressCountry: 'US' },
  areaServed: 'US',
  sameAs: ['https://www.linkedin.com/company/techtranspire'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isReview && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <slot name="head" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify([org, ...jsonLd])} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class:list={{ 'has-hero-header': heroHeader }}>
    <a class="skip-link" href="#main">Skip to main content</a>
    {isReview && (
      <div class="review-bar">
        <div class="container">
          <span><strong>Review build</strong> · not for publication · amber tags mark drafts and unverified items{draft ? ` · ${draft}` : ''}</span>
        </div>
      </div>
    )}
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/interactions.ts';
    </script>
  </body>
</html>
