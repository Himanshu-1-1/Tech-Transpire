---
import '@fontsource-variable/inter';
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/libre-franklin';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { isReview, SITE_NAME } from '../lib/site';
import { logo } from '../lib/images';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  ogImage?: ImageMetadata;
  jsonLd?: object[];
  draft?: string;
}
const { title, description, ogImage, jsonLd = [], draft } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '') || Astro.site!.href;
const og = await getImage({ src: ogImage ?? logo, width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  legalName: 'Akhani LLC',
  url: Astro.site!.href,
  email: 'info@techtranspire.com',
  telephone: '+1-979-479-2779',
  sameAs: ['https://www.linkedin.com/company/techtranspire'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isReview && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" type="image/png" href={(await getImage({ src: logo, width: 64, format: 'png' })).src} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify([org, ...jsonLd])} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        var t = new URLSearchParams(location.search).get('type');
        if (t === 'serif' || t === 'sans') document.documentElement.dataset.type = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    {isReview && (
      <div class="review-bar">
        <div class="container">
          <span><strong>Review build</strong> · not for publication · amber tags mark drafts and unverified items{draft ? ` · ${draft}` : ''}</span>
          <span class="type-switch" aria-label="Typography version">
            <a href="?type=sans" data-type-link="sans">A · Sans</a>
            <a href="?type=serif" data-type-link="serif">B · Serif</a>
          </span>
        </div>
      </div>
    )}
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      const header = document.querySelector('.site-header');
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
      const panel = document.getElementById('mobile-nav');
      btn?.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        if (panel) panel.hidden = open;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
          btn.setAttribute('aria-expanded', 'false');
          if (panel) panel.hidden = true;
          btn.focus();
        }
      });

      const type = document.documentElement.dataset.type || 'sans';
      document.querySelectorAll<HTMLAnchorElement>('[data-type-link]').forEach((a) => {
        a.setAttribute('aria-current', String(a.dataset.typeLink === type));
      });
      if (document.documentElement.dataset.type) {
        document.querySelectorAll<HTMLAnchorElement>('a[href^="/"]').forEach((a) => {
          const u = new URL(a.href);
          u.searchParams.set('type', type);
          a.href = u.pathname + u.search + u.hash;
        });
      }

      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('is-in'));
    </script>
  </body>
</html>
