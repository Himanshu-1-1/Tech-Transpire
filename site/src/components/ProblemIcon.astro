---
// Small working icons for the "Things we look for" cards (Home, D-48), one per card in source order.
// Each acts its idea out in a short loop while the cards are on screen (CSS, .ch-cards.is-live from
// ambient()); still under reduced motion. Strokes use currentColor, so the tile's hover colours apply.
interface Props { n: number }
const { n } = Astro.props;
---
<svg class={`pi pi--${n}`} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  {n === 0 && (
    /* Busy, but not moving forward: two arrows push back and forth in opposite directions. */
    <g>
      <path class="pi-a1" d="M24 11 H8 M12 7 L8 11 L12 15" />
      <path class="pi-a2" d="M8 21 H24 M20 17 L24 21 L20 25" />
    </g>
  )}
  {n === 1 && (
    /* Executing the wrong plan: a dart lands confidently, just off the centre. */
    <g>
      <circle cx="15" cy="17" r="11" /><circle cx="15" cy="17" r="6.5" /><circle class="pi-fill" cx="15" cy="17" r="2" />
      <g class="pi-dart"><path d="M19.5 12.5 L28 4" /><path d="M24 4 L28 4 L28 8" /></g>
    </g>
  )}
  {n === 2 && (
    /* Another deadline, another disappointment: progress runs toward a milestone that becomes an X. */
    <g>
      <circle cx="5" cy="16" r="2.6" /><path d="M7.6 16 H12.4" /><circle cx="15" cy="16" r="2.6" />
      <path class="pi-dash" d="M17.6 16 H22.6" stroke-dasharray="1.6 1.8" />
      <circle cx="26.5" cy="16" r="4" /><path class="pi-x" d="M24.8 14.3 l3.4 3.4 M28.2 14.3 l-3.4 3.4" />
      <circle class="pi-runner pi-fill" cx="5" cy="16" r="1.4" />
    </g>
  )}
  {n === 3 && (
    /* Big decisions, not enough confidence: a shield with a pulsing warning. */
    <g class="pi-shield">
      <path d="M16 3.5 L26 7.5 V15 C26 21.5 21.8 26.2 16 28.5 C10.2 26.2 6 21.5 6 15 V7.5 Z" />
      <path class="pi-bang" d="M16 10 V17" /><circle class="pi-fill pi-bang" cx="16" cy="21.5" r="1.3" />
    </g>
  )}
  {n === 4 && (
    /* The same problems keep coming back: a lens searching below the surface, at the roots. */
    <g>
      <path class="pi-roots" d="M13 20 V24 M13 24 L9 28 M13 24 L17 28 M13 24 L13 29 M9 28 L7 29 M17 28 L19 29" />
      <g class="pi-lens"><circle cx="13" cy="12" r="7" /><path d="M18 17 L23.5 22.5" /></g>
    </g>
  )}
  {n === 5 && (
    /* Everyone's involved, who's accountable: three people around an empty, turning circle. */
    <g>
      <circle class="pi-p pi-p1" cx="16" cy="5.5" r="2.4" /><path class="pi-p pi-p1" d="M12 12.5 C12.5 9.6 19.5 9.6 20 12.5" />
      <circle class="pi-p pi-p2" cx="6" cy="20.5" r="2.4" /><path class="pi-p pi-p2" d="M2 27.5 C2.5 24.6 9.5 24.6 10 27.5" />
      <circle class="pi-p pi-p3" cx="26" cy="20.5" r="2.4" /><path class="pi-p pi-p3" d="M22 27.5 C22.5 24.6 29.5 24.6 30 27.5" />
      <circle class="pi-ring" cx="16" cy="19" r="4.5" stroke-dasharray="2 2.2" />
    </g>
  )}
</svg>
