---
// Premium profile card for Our Team and Advisors (About). Tall portrait above a glass body,
// LinkedIn glass button on the portrait, serif name, role line, and a bio that opens with
// "See more" and closes with "See less" (about-us.astro wires the button). Without a photo, a
// finished initials badge stands in, with no "coming soon" wording (review finding 2026-11-01).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
interface Props { name: string; role: string; bio: string[]; linkedin?: string; photo?: ImageMetadata; focus?: string }
const { name, role, bio, linkedin, photo, focus = '50% 20%' } = Astro.props;
const plain = name.replace(/^Dr\.\s*/, '').split(',')[0];
const initials = plain.split(' ').filter((p) => /^[A-Z]/.test(p)).slice(0, 2).map((p) => p[0]).join('');
---
<li class="card pcard reveal" data-tilt>
  <div class="pc-photo" style={`--fp: ${focus}`} data-pv>
    {photo
      ? <Image src={photo} alt={`${plain}, ${role}`} widths={[420, 840]} sizes="(max-width: 639px) 92vw, (max-width: 1099px) 46vw, 300px" />
      : <div class="pc-ph" aria-hidden="true"><span class="pc-initials">{initials}</span></div>}
    {linkedin && <a class="pc-li" href={linkedin} target="_blank" rel="noopener" aria-label={`${plain} on LinkedIn`}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.5h4v11H3v-11Zm7 0h3.8v1.6h.06c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.77 2.5 4.77 5.75v5.6h-4v-4.96c0-1.18-.02-2.7-1.7-2.7-1.7 0-1.96 1.28-1.96 2.6v5.06H10v-11Z" /></svg></a>}
  </div>
  <div class="pc-body">
    <h3 class="pc-name">{name}</h3>
    <p class="pc-role">{role}</p>
    <details class="pc-bio">
      <summary><span class="pc-lead">{bio[0]}</span>{' '}<span class="pc-more">See more</span></summary>
      {bio.slice(1).map((p) => <p>{p}</p>)}
      <button class="pc-less" type="button" data-pc-less>See less <span aria-hidden="true">↑</span></button>
    </details>
    <slot />
  </div>
</li>
