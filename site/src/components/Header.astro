---
import { Image } from 'astro:assets';
import { primaryNav } from '../lib/site';
import { logo } from '../lib/images';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const current = (href: string) => (path === href ? 'page' : path.startsWith(href + '/') ? 'true' : undefined);
---
<header class="site-header">
  <div class="container hdr">
    <a class="brand" href="/" aria-label="Tech Transpire home">
      <Image src={logo} alt="" width={96} height={96} loading="eager" />
      <span class="brand-text">
        <span class="wordmark"><b>Tech</b> Transpire</span>
        {/* Home only: the supporting line sits under the logo (company request 2026-10-30, D-29). */}
        {path === '/' && <span class="brand-tag">Clarity. Alignment. Execution.</span>}
      </span>
    </a>
    <nav class="nav" aria-label="Primary">
      <ul>
        {primaryNav.map((item) => <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn-primary hdr-cta" href="/contact-us" data-magnetic aria-current={current('/contact-us')}><span class="btn-label">Contact</span></a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav">
      <span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>Menu
    </button>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Primary (mobile)" hidden>
    <ul class="container">
      <li><a href="/" aria-current={current('/')}>Home</a></li>
      {primaryNav.map((item) => <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}
      <li><a href="/contact-us" aria-current={current('/contact-us')}>Contact</a></li>
    </ul>
  </nav>
</header>
