---
// Internal review marker. Renders only in the review build; the public build strips it.
import { isReview } from '../lib/site';
interface Props { label: string; ok?: boolean; block?: boolean }
const { label, ok = false, block = false } = Astro.props;
---
{isReview && <span class:list={['flag', { 'flag--ok': ok, 'flag--block': block }]}>{label}</span>}
