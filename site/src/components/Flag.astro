---
// Internal review marker. Renders only in the review build with REVIEW_MARKERS=1; never in public.
import { showMarkers } from '../lib/site';
interface Props { label: string; ok?: boolean; block?: boolean }
const { label, ok = false, block = false } = Astro.props;
---
{showMarkers && <span class:list={['flag', { 'flag--ok': ok, 'flag--block': block }]}>{label}</span>}
