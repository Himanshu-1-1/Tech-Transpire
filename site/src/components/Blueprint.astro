---
// Architectural line illustration: a curved glass tower drawn as an elevation.
// Used as a supporting motif and where approved photography is still pending.
interface Props { people?: boolean; idSuffix?: string }
const { people = true, idSuffix = 'a' } = Astro.props;
const W = 800, H = 600, GROUND = 520, S = 48;
const q = (a: number, c: number, b: number, t: number) => (1 - t) * (1 - t) * a + 2 * (1 - t) * t * c + t * t * b;
const top = (t: number): [number, number] => [q(250, 480, 860, t), q(170, 50, 20, t)];
const f = (n: number) => n.toFixed(1);
const pts = (k: number) => Array.from({ length: S + 1 }, (_, i) => { const [x, y] = top(i / S); return `${f(x)},${f(y + (GROUND - y) * k)}`; }).join(' ');
const glass = `M${pts(0).split(' ').join(' L')} L860,${GROUND} L250,${GROUND} Z`;
const floors = Array.from({ length: 13 }, (_, k) => pts((k + 1) / 14));
const mullions = Array.from({ length: 31 }, (_, i) => { const [x, y] = top(Math.pow(i / 30, 1.45)); return { x: f(x), y: f(y), strong: i % 5 === 0 }; });
const far = [[40, 330, 80], [108, 270, 72], [168, 360, 60]];
const figures = [[430, 56], [456, 61], [486, 53]];
const gid = `bp-glass-${idSuffix}`;
---
<svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#F7FBFF" stop-opacity=".9" />
      <stop offset="1" stop-color="#BFD6EE" stop-opacity=".75" />
    </linearGradient>
  </defs>
  {far.map(([x, y, w]) => (
    <g>
      <rect class="bp-far" x={x} y={y} width={w} height={GROUND - y} />
      {Array.from({ length: Math.floor(w / 12) }, (_, i) => <line class="bp-floor" x1={x + 8 + i * 12} y1={y + 8} x2={x + 8 + i * 12} y2={GROUND} />)}
    </g>
  ))}
  <path d={glass} fill={`url(#${gid})`} />
  {floors.map((p) => <polyline class="bp-floor" points={p} />)}
  {mullions.map((m) => <line class:list={[m.strong ? 'bp-strong' : 'bp-line']} x1={m.x} y1={m.y} x2={m.x} y2={GROUND} />)}
  <polyline class="bp-strong" points={pts(0)} />
  <line class="bp-strong" x1="250" y1="170" x2="250" y2={GROUND} />
  <line class="bp-strong" x1="0" y1={GROUND} x2={W} y2={GROUND} />
  {people && figures.map(([x, h]) => (
    <g>
      <path class="bp-person" d={`M${x - 3.5} ${GROUND}l-1 -${h * 0.42}l-1.6 -${h * 0.02}q-.4 -${h * 0.3} 6.1 -${h * 0.33}q6.5 .03 6.1 ${h * 0.33}l-1.6 ${h * 0.02}l-1 ${h * 0.42}z`} />
      <circle class="bp-person" cx={x} cy={GROUND - h + 5} r="4.6" />
    </g>
  ))}
</svg>
