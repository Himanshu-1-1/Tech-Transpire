---
import { Image } from 'astro:assets';
import Flag from './Flag.astro';
import { contact, entityLine, showIndustries, showPrivacy, location } from '../lib/site';
import { hasCaseStudiesPage } from '../lib/routes';
import { logo } from '../lib/images';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container foot-grid">
    <div class="foot-brand">
      <a class="brand" href="/" aria-label="Tech Transpire home">
        <Image src={logo} alt="" width={96} height={96} />
        <span class="wordmark"><b>Tech</b> Transpire</span>
      </a>
      <p class="tagline">Clarity. Alignment. Execution.</p>
      <p class="place">{location.label}</p>
    </div>
    <nav class="foot-col" aria-labelledby="foot-explore">
      <h2 id="foot-explore">Explore</h2>
      <ul>
        <li><a href="/services">Services</a></li>
        {showIndustries && <li><a href="/industries">Industries</a></li>}
        <li><a href="/insights">Insights</a></li>
        {hasCaseStudiesPage && <li><a href="/insights/case-studies">Case studies</a></li>}
        <li><a href="/about-us">About</a></li>
        <li><a href="/contact-us">Contact Us</a></li>
      </ul>
    </nav>
    <div class="foot-col">
      <h2>Get in touch</h2>
      <ul>
        <li class="wide"><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li><a href={`tel:${contact.tel}`}>{contact.phone}</a></li>
        <li><a href={contact.linkedin} rel="noopener" target="_blank">LinkedIn</a></li>
        <li class="wide"><a href={contact.booking} rel="noopener" target="_blank">Book your intro call</a></li>
      </ul>
    </div>
  </div>
  <div class="container">
    <div class="legal">
      <p>{entityLine} © {year} Akhani LLC.<Flag label="N-06 · legal wording review" /></p>
      {showPrivacy && <ul><li><a href="/privacy-policy">Privacy Policy</a></li></ul>}
    </div>
  </div>
</footer>
