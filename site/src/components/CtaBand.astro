---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import LineField from './LineField.astro';
import type { Cta } from '../lib/content';
interface Props { eyebrow?: string; line: string; sub?: string; ctas: Cta[]; photo?: ImageMetadata; id?: string }
const { eyebrow, line, sub, ctas, photo, id } = Astro.props;
const [primary, ...rest] = ctas;
const external = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
---
<section class="cta-band on-navy" id={id} data-glow>
  {photo
    ? <div class="cta-media"><Image src={photo} alt="" widths={[800, 1400]} sizes="58vw" /></div>
    : <div class="band-art" data-ambient><LineField tone="dark" /></div>}
  <div class="container">
    {eyebrow && <p class="eyebrow reveal">{eyebrow}</p>}
    <p class="cta-line" data-split>{line}<slot name="flag" /></p>
    {sub && <p class="sub reveal">{sub}</p>}
    <div class="ctas reveal">
      {primary && <a class="btn btn-light" href={primary.href} data-magnetic {...external(primary.href)}><span class="btn-label">{primary.label}</span> <span class="arr" aria-hidden="true">→</span></a>}
      {rest.map((c) => <a class="link-arrow" href={c.href} {...external(c.href)}>{c.label} <span class="arr" aria-hidden="true">→</span></a>)}
    </div>
  </div>
</section>
