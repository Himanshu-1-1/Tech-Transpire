---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Cta } from '../lib/content';
interface Props { eyebrow?: string; line: string; sub?: string; ctas: Cta[]; photo?: ImageMetadata }
const { eyebrow, line, sub, ctas, photo } = Astro.props;
const [primary, ...rest] = ctas;
---
<section class="cta-band on-navy">
  {photo ? (
    <div class="cta-media"><Image src={photo} alt="" widths={[800, 1400]} sizes="55vw" /></div>
  ) : (
    <svg class="chevrons" viewBox="0 0 560 360" aria-hidden="true">
      <polygon points="40,40 260,40 360,180 260,320 40,320 140,180" />
      <polygon points="200,40 420,40 520,180 420,320 200,320 300,180" />
      <polygon points="340,40 560,40 660,180 560,320 340,320 440,180" />
    </svg>
  )}
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <p class="cta-line">{line}<slot name="flag" /></p>
    {sub && <p class="sub">{sub}</p>}
    <div class="ctas">
      {primary && <a class="btn btn-light" href={primary.href}>{primary.label}</a>}
      {rest.map((c) => <a class="btn btn-text link-arrow" href={c.href} {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{c.label} <span class="arr" aria-hidden="true">→</span></a>)}
    </div>
  </div>
</section>
