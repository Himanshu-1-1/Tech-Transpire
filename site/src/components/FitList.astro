---
import Icon from './Icon.astro';
interface Props { items: { fit: boolean; text: string }[]; yesTitle?: string; noTitle?: string }
// Headings as on the live site (techtranspire.com, confirmed by the company 2026-10-30).
const { items, yesTitle = 'This is for you if', noTitle = 'We may not be the right fit for you if' } = Astro.props;
const yes = items.filter((i) => i.fit);
const no = items.filter((i) => !i.fit);
---
<div class="fit-grid reveal">
  <div class="fit-col fit-col--yes">
    <h3><Icon name="check" />{yesTitle}</h3>
    <ul>{yes.map((i, k) => <li style={`--k:${k}`}><Icon name="yes" class="" /><span>{i.text}</span></li>)}</ul>
  </div>
  <div class="fit-col fit-col--no">
    <h3><Icon name="shield" />{noTitle}</h3>
    <ul>{no.map((i, k) => <li style={`--k:${k}`}><Icon name="no" class="" /><span>{i.text}</span></li>)}</ul>
  </div>
</div>
