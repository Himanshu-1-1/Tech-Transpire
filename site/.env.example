# Server-side configuration for /api/inquiry. Copy to .env for local testing ONLY;
# in production set these in the host's environment settings. Never commit real values.
# With none of these set, the form returns 503 and visitors see the failure message.

# --- Zoho CRM (self-client OAuth; https://api-console.zoho.com) ---
# Scope needed when generating the refresh token: ZohoCRM.modules.leads.CREATE
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Must match the account's data centre (.com, .eu, .in, .com.au, .jp, .ca)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://www.zohoapis.com
ZOHO_API_VERSION=v8
# Optional: an existing Lead_Source picklist value, e.g. Website
ZOHO_LEAD_SOURCE=
# Optional: API names of custom Lead fields (create them in Zoho first)
ZOHO_FIELD_AREA=
ZOHO_FIELD_CONSENT=
# Optional: prefix for a clickable lead link in the email, e.g. https://crm.zoho.com/crm/org<ID>/tab/Leads/
ZOHO_CRM_LEAD_URL=

# --- Email notification (SMTP, e.g. Zoho Mail smtp.zoho.com:465) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=info@techtranspire.com
