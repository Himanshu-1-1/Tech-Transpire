{
   "$id" : "challenge.schema.json",
   "$schema" : "https://json-schema.org/draft/2020-12/schema",
   "properties" : {
      "body" : {
         "type" : "string"
      },
      "capabilities" : {
         "items" : {
            "$ref" : "_common.schema.json#/$defs/relation"
         },
         "type" : "array"
      },
      "icon_key" : {
         "type" : "string"
      },
      "id" : {
         "pattern" : "^CHL-[0-9]{2}$",
         "type" : "string"
      },
      "provenance" : {
         "$ref" : "_common.schema.json#/$defs/provenance"
      },
      "title" : {
         "type" : "string"
      }
   },
   "required" : [
      "id",
      "title",
      "body",
      "provenance"
   ],
   "title" : "Challenge",
   "type" : "object"
}
