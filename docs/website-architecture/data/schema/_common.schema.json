{
   "$defs" : {
      "path" : {
         "pattern" : "^/([a-z0-9-]+(/[a-z0-9-]+)*)?$",
         "type" : "string"
      },
      "provenance" : {
         "description" : "Only preserved-verbatim, edited-approved and new-approved content may be published.",
         "properties" : {
            "approved_by" : {
               "type" : "string"
            },
            "change_record" : {
               "items" : {
                  "properties" : {
                     "approved_by" : {
                        "type" : "string"
                     },
                     "date" : {
                        "format" : "date",
                        "type" : "string"
                     },
                     "decision_id" : {
                        "pattern" : "^[DE]-[0-9]{2}$",
                        "type" : "string"
                     },
                     "field" : {
                        "type" : "string"
                     },
                     "new_text" : {
                        "type" : "string"
                     },
                     "previous_text" : {
                        "type" : "string"
                     }
                  },
                  "required" : [
                     "date",
                     "field",
                     "previous_text",
                     "new_text",
                     "approved_by"
                  ],
                  "type" : "object"
               },
               "type" : "array"
            },
            "preservation_status" : {
               "enum" : [
                  "preserved-verbatim",
                  "edited-approved",
                  "new-pending",
                  "new-approved"
               ]
            },
            "source_block_ids" : {
               "items" : {
                  "pattern" : "^TT-[A-Z]+-[0-9]{3}(-B[0-9]{2})?$",
                  "type" : "string"
               },
               "type" : "array"
            },
            "updated_at" : {
               "format" : "date-time",
               "type" : "string"
            }
         },
         "required" : [
            "source_block_ids",
            "preservation_status",
            "updated_at"
         ],
         "type" : "object"
      },
      "relation" : {
         "additionalProperties" : false,
         "properties" : {
            "basis" : {
               "description" : "Block or article ID that justifies the relationship (08 Â§5)",
               "minLength" : 3,
               "type" : "string"
            },
            "id" : {
               "type" : "string"
            }
         },
         "required" : [
            "id",
            "basis"
         ],
         "type" : "object"
      },
      "seo" : {
         "properties" : {
            "canonical" : {
               "format" : "uri",
               "type" : "string"
            },
            "meta_description" : {
               "maxLength" : 160,
               "minLength" : 70,
               "type" : "string"
            },
            "meta_title" : {
               "maxLength" : 60,
               "type" : "string"
            },
            "og_image" : {
               "pattern" : "^TT-AS-[0-9]{3}$",
               "type" : "string"
            },
            "robots" : {
               "default" : "index,follow",
               "type" : "string"
            }
         },
         "required" : [
            "meta_title",
            "meta_description"
         ],
         "type" : "object"
      },
      "slug" : {
         "pattern" : "^[a-z0-9]+(-[a-z0-9]+)*$",
         "type" : "string"
      },
      "status" : {
         "enum" : [
            "draft",
            "in-review",
            "published",
            "retired"
         ]
      }
   },
   "$id" : "_common.schema.json",
   "$schema" : "https://json-schema.org/draft/2020-12/schema",
   "title" : "Shared definitions"
}
