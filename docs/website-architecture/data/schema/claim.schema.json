{
   "$id" : "claim.schema.json",
   "$schema" : "https://json-schema.org/draft/2020-12/schema",
   "properties" : {
      "attribution" : {
         "enum" : [
            "tech-transpire",
            "founder-prior-experience",
            "individual"
         ]
      },
      "claim_id" : {
         "pattern" : "^C-[0-9]{2}$",
         "type" : "string"
      },
      "evidence_note" : {
         "type" : "string"
      },
      "label" : {
         "type" : "string"
      },
      "source_block_ids" : {
         "items" : {
            "type" : "string"
         },
         "type" : "array"
      },
      "substantiated_by" : {
         "pattern" : "^TT-INS-[0-9]{3}$",
         "type" : "string"
      },
      "value" : {
         "type" : "string"
      },
      "verification_status" : {
         "description" : "Only verified claims may render",
         "enum" : [
            "unverified",
            "verified",
            "rejected"
         ]
      },
      "verified_at" : {
         "format" : "date",
         "type" : "string"
      },
      "verified_by" : {
         "type" : "string"
      }
   },
   "required" : [
      "claim_id",
      "value",
      "label",
      "source_block_ids",
      "attribution",
      "verification_status"
   ],
   "title" : "Claim / evidence",
   "type" : "object"
}
