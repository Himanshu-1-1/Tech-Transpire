{
   "$id" : "person.schema.json",
   "$schema" : "https://json-schema.org/draft/2020-12/schema",
   "properties" : {
      "approved_title" : {
         "type" : "string"
      },
      "biography" : {
         "type" : "string"
      },
      "capabilities" : {
         "items" : {
            "$ref" : "_common.schema.json#/$defs/relation"
         },
         "type" : "array"
      },
      "credentials" : {
         "items" : {
            "pattern" : "^C-[0-9]{2}$",
            "type" : "string"
         },
         "type" : "array"
      },
      "headshot" : {
         "pattern" : "^TT-AS-[0-9]{3}$",
         "type" : "string"
      },
      "id" : {
         "pattern" : "^PER-[0-9]{2}$",
         "type" : "string"
      },
      "is_author" : {
         "type" : "boolean"
      },
      "linkedin_url" : {
         "format" : "uri",
         "type" : "string"
      },
      "name" : {
         "type" : "string"
      },
      "provenance" : {
         "$ref" : "_common.schema.json#/$defs/provenance"
      },
      "publication_approval" : {
         "properties" : {
            "approved" : {
               "type" : "boolean"
            },
            "approved_by" : {
               "type" : "string"
            },
            "date" : {
               "format" : "date",
               "type" : "string"
            }
         },
         "required" : [
            "approved"
         ],
         "type" : "object"
      },
      "show_on_about" : {
         "type" : "boolean"
      },
      "slug" : {
         "$ref" : "_common.schema.json#/$defs/slug"
      }
   },
   "required" : [
      "id",
      "name",
      "approved_title",
      "biography",
      "show_on_about",
      "publication_approval",
      "provenance"
   ],
   "title" : "Person",
   "type" : "object"
}
