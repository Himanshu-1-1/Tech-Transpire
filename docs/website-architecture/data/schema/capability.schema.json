{
   "$id" : "capability.schema.json",
   "$schema" : "https://json-schema.org/draft/2020-12/schema",
   "properties" : {
      "aliases" : {
         "description" : "Brief capability names (08 Â§4); metadata and search synonyms only",
         "items" : {
            "type" : "string"
         },
         "type" : "array"
      },
      "challenges" : {
         "items" : {
            "$ref" : "_common.schema.json#/$defs/relation"
         },
         "type" : "array"
      },
      "engagement_types" : {
         "items" : {
            "pattern" : "^ENG-[0-9]{2}$",
            "type" : "string"
         },
         "type" : "array"
      },
      "has_detail_page" : {
         "default" : false,
         "type" : "boolean"
      },
      "id" : {
         "pattern" : "^CAP-[0-9]{2}$",
         "type" : "string"
      },
      "name" : {
         "type" : "string"
      },
      "original_source" : {
         "type" : "string"
      },
      "outcome_themes" : {
         "items" : {
            "$ref" : "_common.schema.json#/$defs/relation"
         },
         "type" : "array"
      },
      "provenance" : {
         "$ref" : "_common.schema.json#/$defs/provenance"
      },
      "related_capabilities" : {
         "items" : {
            "$ref" : "_common.schema.json#/$defs/relation"
         },
         "type" : "array"
      },
      "related_industries" : {
         "items" : {
            "$ref" : "_common.schema.json#/$defs/relation"
         },
         "type" : "array"
      },
      "related_insights" : {
         "items" : {
            "$ref" : "_common.schema.json#/$defs/relation"
         },
         "type" : "array"
      },
      "slug" : {
         "$ref" : "_common.schema.json#/$defs/slug"
      },
      "summary" : {
         "type" : "string"
      }
   },
   "required" : [
      "id",
      "name",
      "slug",
      "summary",
      "has_detail_page",
      "original_source",
      "provenance"
   ],
   "title" : "Capability (Expertise component)",
   "type" : "object"
}
