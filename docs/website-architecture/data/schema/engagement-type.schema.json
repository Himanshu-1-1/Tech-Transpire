{
   "$id" : "engagement-type.schema.json",
   "$schema" : "https://json-schema.org/draft/2020-12/schema",
   "properties" : {
      "body" : {
         "type" : "string"
      },
      "capabilities" : {
         "items" : {
            "pattern" : "^CAP-[0-9]{2}$",
            "type" : "string"
         },
         "type" : "array"
      },
      "entry_point" : {
         "type" : "boolean"
      },
      "id" : {
         "pattern" : "^ENG-[0-9]{2}$",
         "type" : "string"
      },
      "name" : {
         "type" : "string"
      },
      "order" : {
         "type" : "integer"
      },
      "provenance" : {
         "$ref" : "_common.schema.json#/$defs/provenance"
      },
      "typical_duration" : {
         "description" : "From source only",
         "type" : "string"
      }
   },
   "required" : [
      "id",
      "name",
      "body",
      "order",
      "entry_point",
      "provenance"
   ],
   "title" : "Engagement type",
   "type" : "object"
}
