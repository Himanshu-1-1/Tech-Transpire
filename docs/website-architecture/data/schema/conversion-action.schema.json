{
   "$id" : "conversion-action.schema.json",
   "$schema" : "https://json-schema.org/draft/2020-12/schema",
   "properties" : {
      "area_of_interest_options" : {
         "items" : {
            "properties" : {
               "basis_block" : {
                  "description" : "Source block the option derives from, e.g. TT-PG-002-B04",
                  "type" : "string"
               },
               "crm_value" : {
                  "description" : "Zoho picklist value",
                  "type" : "string"
               },
               "label" : {
                  "type" : "string"
               },
               "value" : {
                  "type" : "string"
               }
            },
            "required" : [
               "value",
               "label"
            ],
            "type" : "object"
         },
         "type" : "array"
      },
      "audience" : {
         "items" : {
            "type" : "string"
         },
         "type" : "array"
      },
      "consent" : {
         "properties" : {
            "privacy_policy_ref" : {
               "type" : "string"
            },
            "required" : {
               "type" : "boolean"
            },
            "text" : {
               "type" : "string"
            }
         },
         "type" : "object"
      },
      "destinations" : {
         "items" : {
            "properties" : {
               "kind" : {
                  "enum" : [
                     "zoho-crm",
                     "email",
                     "webhook"
                  ]
               },
               "role" : {
                  "enum" : [
                     "primary",
                     "notification",
                     "fallback"
                  ]
               },
               "target" : {
                  "description" : "Module or address; never a secret",
                  "type" : "string"
               }
            },
            "required" : [
               "role",
               "kind",
               "target"
            ],
            "type" : "object"
         },
         "type" : "array"
      },
      "fields" : {
         "items" : {
            "properties" : {
               "crm_field" : {
                  "description" : "Zoho CRM API field name, e.g. Last_Name",
                  "type" : "string"
               },
               "label" : {
                  "type" : "string"
               },
               "max_length" : {
                  "type" : "integer"
               },
               "name" : {
                  "type" : "string"
               },
               "options" : {
                  "items" : {
                     "properties" : {
                        "label" : {
                           "type" : "string"
                        },
                        "value" : {
                           "type" : "string"
                        }
                     },
                     "type" : "object"
                  },
                  "type" : "array"
               },
               "required" : {
                  "type" : "boolean"
               },
               "type" : {
                  "enum" : [
                     "text",
                     "email",
                     "tel",
                     "select",
                     "textarea",
                     "checkbox"
                  ]
               },
               "validation" : {
                  "type" : "string"
               }
            },
            "required" : [
               "name",
               "label",
               "type",
               "required"
            ],
            "type" : "object"
         },
         "type" : "array"
      },
      "id" : {
         "pattern" : "^CONV-[0-9]{2}$",
         "type" : "string"
      },
      "motivation" : {
         "type" : "string"
      },
      "name" : {
         "type" : "string"
      },
      "provenance" : {
         "$ref" : "_common.schema.json#/$defs/provenance"
      },
      "spam_protection" : {
         "items" : {
            "enum" : [
               "honeypot",
               "min-submit-time",
               "rate-limit",
               "challenge"
            ]
         },
         "type" : "array"
      },
      "states" : {
         "properties" : {
            "error_message" : {
               "type" : "string"
            },
            "success_message" : {
               "description" : "Shown only on confirmed delivery (T8)",
               "type" : "string"
            },
            "validation_messages" : {
               "type" : "object"
            }
         },
         "required" : [
            "success_message",
            "error_message"
         ],
         "type" : "object"
      },
      "tracking_event" : {
         "properties" : {
            "name" : {
               "type" : "string"
            },
            "parameters" : {
               "description" : "Never personal data",
               "items" : {
                  "type" : "string"
               },
               "type" : "array"
            }
         },
         "required" : [
            "name"
         ],
         "type" : "object"
      },
      "type" : {
         "enum" : [
            "booking-link",
            "form",
            "email",
            "phone"
         ]
      }
   },
   "required" : [
      "id",
      "name",
      "type",
      "tracking_event"
   ],
   "title" : "Conversion action / form",
   "type" : "object"
}
